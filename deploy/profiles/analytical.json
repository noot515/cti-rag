{
  "name": "analytical",
  "components": [
    "api",
    "worker",
    "mysql-metadata",
    "file-object-store",
    "lexical",
    "dense",
    "redis",
    "rabbitmq",
    "duckdb",
    "neo4j"
  ],
  "exposed_ports": [
    "api:8000"
  ],
  "secret_names": [
    "MYSQL_PASSWORD",
    "NEO4J_PASSWORD",
    "RABBITMQ_PASSWORD"
  ],
  "internal_network": true,
  "egress_policy": "deny_by_default",
  "egress_allowlist": [],
  "data_root_env": "CTI_RAG_DATA_ROOT",
  "resource_limits": [
    {
      "service": "api",
      "cpu": "2",
      "memory": "4GiB"
    },
    {
      "service": "worker",
      "cpu": "6",
      "memory": "12GiB"
    },
    {
      "service": "neo4j",
      "cpu": "4",
      "memory": "8GiB"
    }
  ],
  "optional_components": [
    "reranker",
    "generator"
  ]
}
