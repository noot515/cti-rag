# Optional OpenCTI source adapter. Copy into the ingestion worker environment.
OPENCTI_URL=https://opencti.example
OPENCTI_TOKEN=
OPENCTI_TIMEOUT_SECONDS=15
OPENCTI_PAGE_SIZE=50
# OPENCTI_CA_BUNDLE=/etc/ssl/certs/opencti-ca.pem
# OPENCTI_CLIENT_CERT=/etc/opencti/client.crt
# OPENCTI_CLIENT_KEY=/etc/opencti/client.key
# OPENCTI_PROXY=http://proxy.example:8080
# OPENCTI_TENANT_ID=tenant-a
